{
  "name": "dsh-taskboard",
  "version": "0.3.0",
  "description": "Sidebar panel for headless dispatches in DeepSeek Harness: live state, log tail, start, stop, restart, and archive finished jobs",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "scripts",
    "docs",
    "cordis.patch.yml",
    "build.sh",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "sidebar",
    "dispatches",
    "headless"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/damoojeje/dsh-taskboard.git"
  },
  "homepage": "https://github.com/damoojeje/dsh-taskboard",
  "scripts": {
    "build": "bash build.sh",
    "smoke": "node scripts/smoke.mjs",
    "test": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.2": "compatible"
      }
    }
  }
}
